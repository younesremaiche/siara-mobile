{
  "expo": {
    "name": "SIARA",
    "slug": "siara-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logos/siara-icon-square.png",
    "splash": {
      "image": "./src/assets/logos/siara-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7A3DF0"
    },
    "scheme": "com.siara.mobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siara.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SIARA needs your location to show real-time road risk at your position.",
        "NSCameraUsageDescription": "SIARA needs camera access so you can take a photo of the incident when reporting.",
        "NSPhotoLibraryUsageDescription": "SIARA needs photo library access so you can attach photos to your report."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logos/siara-adaptive-foreground.png",
        "backgroundColor": "#7A3DF0"
      },
      "package": "com.siara.mobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCwwC7lp0np11wmccizGFN55-45Az8-2rQ"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "CAMERA"
      ]
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logos/siara-icon-square.png",
          "color": "#7A3DF0"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SIARA needs your location to show real-time road risk at your position."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SIARA needs camera access so you can take a photo of the incident when reporting.",
          "photosPermission": "SIARA needs photo library access so you can attach photos to your report."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e896aea7-e4ab-4856-b708-b0d286778738"
      }
    }
  }
}
